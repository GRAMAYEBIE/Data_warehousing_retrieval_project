# Copy to .env and replace every "change_me" value. Never commit .env.

# --- PostgreSQL (warehouse) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=warehouse
POSTGRES_PORT=5432

# Least-privilege roles (see infra/postgres/init/02_roles.sql)
LOADER_PASSWORD=change_me
TRANSFORMER_PASSWORD=change_me
PUBLISHER_PASSWORD=change_me
SUPERSET_READER_PASSWORD=change_me
AI_READER_PASSWORD=change_me
AI_AUDIT_WRITER_PASSWORD=change_me

# Tool metadata databases (same server, separate databases)
AIRFLOW_DB_PASSWORD=change_me
SUPERSET_DB_PASSWORD=change_me

# --- RustFS (S3-compatible landing zone) ---
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me
S3_BUCKET=nyc-taxi-lake
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

# --- Ingestion ---
TLC_BASE_URL=https://d37ci6vzurychx.cloudfront.net
# Rows per COPY batch when loading bronze
INGEST_BATCH_ROWS=200000

# --- Demo mode (one month, small model) ---
DEMO_MODE=false
DEMO_MONTH=2025-01
