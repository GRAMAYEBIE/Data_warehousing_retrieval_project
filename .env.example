# Copy to .env and replace every "change_me" value. Never commit .env.

# --- PostgreSQL (warehouse) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=warehouse
POSTGRES_PORT=5432

# Least-privilege roles (see infra/postgres/init/02_roles.sql)
LOADER_PASSWORD=change_me
TRANSFORMER_PASSWORD=change_me
PUBLISHER_PASSWORD=change_me
SUPERSET_READER_PASSWORD=change_me
AI_READER_PASSWORD=change_me
AI_AUDIT_WRITER_PASSWORD=change_me

# Tool metadata databases (same server, separate databases)
AIRFLOW_DB_PASSWORD=change_me
SUPERSET_DB_PASSWORD=change_me

# --- RustFS (S3-compatible landing zone) ---
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me
S3_BUCKET=nyc-taxi-lake
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

# --- Ingestion ---
TLC_BASE_URL=https://d37ci6vzurychx.cloudfront.net
# Rows per COPY batch when loading bronze
INGEST_BATCH_ROWS=200000

# --- Airflow (profile orchestration) ---
AIRFLOW_PORT=8080
# Login "admin" on http://localhost:8080
AIRFLOW_ADMIN_PASSWORD=change_me
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change_me
AIRFLOW_API_SECRET_KEY=change_me
AIRFLOW_JWT_SECRET=change_me
# Schedule of the monthly pipeline (cron). Each scheduled run targets the month two months
# before its date (TLC publication delay). Leave empty for manual runs only, e.g. while
# loading historical months: trigger with {"month": "YYYY-MM"}.
PIPELINE_SCHEDULE=0 6 3 * *
# Pipeline tasks running at the same time. 1 fits a 4-CPU / 4 GB Docker host; raise it
# (2 to 4) on a larger machine.
PIPELINE_MAX_ACTIVE_TASKS=1
# Optional: POST the outcome of each pipeline run to this URL (Slack/Teams-style webhook)
NOTIFY_WEBHOOK_URL=

# --- Superset (profile bi) ---
SUPERSET_PORT=8088
# Login "admin" on http://localhost:8088
SUPERSET_ADMIN_PASSWORD=change_me
# Long random string: openssl rand -base64 42
SUPERSET_SECRET_KEY=change_me

# --- AI assistant (profile ai) ---
OLLAMA_PORT=11434
# CPU-only laptop: qwen2.5:3b. On a GPU machine: qwen2.5:7b or qwen2.5:14b.
OLLAMA_MODEL=qwen2.5:3b
# Model threads (0: Ollama decides, one per physical core) and how long the API waits for
# the model (a laptop CPU reads about 4 prompt tokens per second when the host is busy).
OLLAMA_NUM_THREAD=0
LLM_TIMEOUT_S=900
# How the plan's JSON is obtained: free (default, validated by Pydantic with one repair
# attempt), json (generic JSON grammar) or schema (decoding constrained to the schema:
# exact but 3 to 20 times slower on a CPU). Measurements in the README.
LLM_OUTPUT_MODE=free
# Model calls at the same time: 1 on a CPU (two calls share the cores and both slow
# down), 2 to 4 on a GPU.
LLM_MAX_CONCURRENCY=1
# Retrieval for the planner: values named in the question and the closest validated
# example plans (true), or the bare prompt (false, used to measure the gain).
ASSISTANT_RAG=true
API_PORT=8000
# Web interface of the assistant (http://localhost:8090). The URLs are the ones the
# managers' browsers use to open Superset; Platform health (Grafana) is shown to
# administrators only (true on the operator's deployment).
WEB_PORT=8090
SUPERSET_PUBLIC_URL=http://localhost:8088
GRAFANA_PUBLIC_URL=http://localhost:3000
SHOW_PLATFORM_HEALTH=false
# Bearer token required by the assistant API (long random string)
API_TOKEN=change_me
# Superset service account used by the assistant to create DRAFT dashboards (role Alpha)
SUPERSET_AI_PASSWORD=change_me

# --- Observability (profile observability) ---
# Grafana on http://localhost:3000 (login "admin"), Prometheus :9090, Alertmanager :9093
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change_me
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
# Read-only role of postgres-exporter and Grafana (database statistics + ops tables only)
METRICS_READER_PASSWORD=change_me
# Airflow and Superset send StatsD metrics to statsd-exporter (started with core).
# The assistant sends its traces to Tempo when this is set (http://tempo:4318).
METRICS_STATSD_ON=true
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Machine learning (profile ml, see infra/postgres/init/08_ml.sql) ---
# MLflow UI on http://localhost:5500; runs in PostgreSQL (mlflow_meta), models in RustFS.
MLFLOW_PORT=5500
MLFLOW_BUCKET=mlflow
MLFLOW_DB_PASSWORD=change_me
# Role of the forecasting job: reads the published layer, writes the ml schema only.
FORECASTER_PASSWORD=change_me

# --- Demo mode (one month, small model) ---
DEMO_MODE=false
DEMO_MONTH=2025-01
