  },
  {
   "type": "logs",
   "title": "PostgreSQL errors and restarts",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{service=\"postgres\"} |~ \"(?i)error|fatal|panic|terminated|shut ?down\"",
     "refId": "A"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   },
   "id": 9,
