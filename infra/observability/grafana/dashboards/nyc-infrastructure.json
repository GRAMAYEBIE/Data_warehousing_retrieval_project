  {
   "type": "timeseries",
   "title": "Connections by database",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (datname) (pg_stat_database_numbackends)",
     "legendFormat": "{{datname}}",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 8,
      "lineWidth": 2,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
