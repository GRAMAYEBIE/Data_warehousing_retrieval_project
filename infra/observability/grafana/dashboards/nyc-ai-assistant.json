   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "round(sum(increase(assistant_narrative_checks_total{check=\"replaced\"}[24h])) or vector(0))",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
