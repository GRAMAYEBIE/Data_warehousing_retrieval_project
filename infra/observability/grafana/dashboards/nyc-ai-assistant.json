 "panels": [
  {
   "type": "stat",
   "title": "Answers (24 h)",
   "description": "Exact count from the audit log (every answer is a row), not an estimate from a counter.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(nyc_ai_audit_answers_24h) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "green"
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [],
     "noValue": "no data"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Median answer time (1 h)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(assistant_answer_seconds_bucket[1h])))",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "green"
       },
       {
        "value": 180,
        "color": "#EAB839"
       },
       {
        "value": 300,
        "color": "red"
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [],
     "noValue": "no question (1 h)"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
