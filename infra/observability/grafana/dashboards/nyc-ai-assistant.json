   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 8,
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "table",
   "title": "Last answers (audit log): open a trace from its id",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "warehouse"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "warehouse"
     },
     "rawSql": "SELECT created_at, verdict, left(question, 70) AS question, duration_ms / 1000 AS seconds,\n               narrative_check, trace_id, left(reasons::text, 120) AS reasons\n        FROM ops.ai_audit_log ORDER BY event_id DESC LIMIT 20",
     "format": "table",
     "refId": "A",
     "editorMode": "code",
     "rawQuery": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "trace_id"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Open the trace",
          "url": "/explore?left={\"datasource\": \"tempo\", \"queries\": [{\"refId\": \"A\", \"queryType\": \"traceql\", \"query\": \"${__value.raw}\"}]}"
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "id": 9,
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 9
   }
  },
  {
   "type": "logs",
   "title": "Assistant log (one line per answer, with its trace)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{service=\"api\"} |= \"answer status=\"",
     "refId": "A"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   },
   "id": 10,
   "gridPos": {
    "x": 0,
    "y": 29,
    "w": 24,
    "h": 7
   }
  },
  {
   "type": "traces",
   "title": "Recent traces of the assistant",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "targets": [
    {
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceqlSearch",
     "refId": "A",
     "query": "{resource.service.name=\"nyc-taxi-assistant\"}",
     "limit": 20
    }
   ],
   "id": 11,
   "gridPos": {
    "x": 0,
    "y": 36,
    "w": 24,
    "h": 8
   }
  }
 ],
