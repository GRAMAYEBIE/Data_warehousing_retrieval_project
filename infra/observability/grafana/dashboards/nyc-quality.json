  {
   "type": "table",
   "title": "Reconciliation per source month",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "warehouse"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "warehouse"
     },
     "rawSql": "SELECT to_char(source_month, 'YYYY-MM') AS month, file_rows, bronze_rows, silver_rows,\n               quarantine_rows, unexplained_rows, valid_rows, suspicious_rows, invalid_rows,\n               valid_trip_rate_pct, unexplained_amount\n        FROM analytics.recon_bronze_silver ORDER BY source_month",
     "format": "table",
     "refId": "A",
     "editorMode": "code",
     "rawQuery": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "valid_trip_rate_pct"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "value": null,
           "color": "red"
          },
          {
           "value": 85,
           "color": "#EAB839"
          },
          {
           "value": 90,
           "color": "green"
          }
         ]
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background",
         "mode": "basic"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "unexplained_rows"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "value": null,
           "color": "green"
          },
          {
           "value": 1,
           "color": "red"
          }
         ]
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background",
         "mode": "basic"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "id": 4,
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 7
   }
  },
  {
   "type": "table",
   "title": "Quality flags per source month (rows)",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "warehouse"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "warehouse"
     },
     "rawSql": "SELECT to_char(source_month, 'YYYY-MM') AS month, negative_amount_rows,\n               pickup_after_dropoff_rows, duplicate_rows, out_of_period_rows,\n               implausible_speed_rows, implausible_distance_rows, unrealistic_duration_rows,\n               zero_distance_rows, null_zone_rows, unknown_payment_rows, unknown_ratecode_rows,\n               cross_month_rows, not_reported_rows, component_mismatch_rows\n        FROM analytics.recon_bronze_silver ORDER BY source_month",
     "format": "table",
     "refId": "A",
     "editorMode": "code",
     "rawQuery": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "id": 5,
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 24,
    "h": 7
   }
  },
