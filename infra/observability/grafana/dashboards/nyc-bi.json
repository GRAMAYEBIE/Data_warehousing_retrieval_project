{
 "uid": "nyc-bi",
 "title": "4. BI: Superset and its cache",
 "description": "Superset activity (StatsD), the Redis cache and the refresh of the dashboards after each publication.",
 "tags": [
  "nyc-taxi",
  "bi"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "editable": false,
 "graphTooltip": 1,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "links": [
  {
   "title": "Overview",
   "type": "link",
   "url": "/d/nyc-overview",
   "targetBlank": false,
   "icon": "dashboard"
  },
  {
   "title": "Pipeline",
   "type": "link",
   "url": "/d/nyc-pipeline",
   "targetBlank": false,
   "icon": "dashboard"
  },
  {
   "title": "Data quality",
   "type": "link",
   "url": "/d/nyc-quality",
   "targetBlank": false,
   "icon": "dashboard"
  },
  {
   "title": "Infrastructure",
   "type": "link",
   "url": "/d/nyc-infrastructure",
   "targetBlank": false,
   "icon": "dashboard"
  },
  {
   "title": "AI assistant",
   "type": "link",
   "url": "/d/nyc-ai-assistant",
   "targetBlank": false,
   "icon": "dashboard"
  }
 ],
 "panels": [
  {
   "type": "timeseries",
   "title": "Superset events per minute",
   "description": "Dashboard loads, chart queries, API calls.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (__name__) (rate({__name__=~\"superset_.*_count|superset_.*_total\"}[5m])) * 60",
     "legendFormat": "{{__name__}}",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 8,
      "lineWidth": 2,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Cache hit ratio (Redis)",
   "description": "Charts served from the 24 h cache rather than PostgreSQL.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]))",
     "legendFormat": "hit ratio",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 8,
      "lineWidth": 2,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 2,
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Redis memory",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "redis_memory_used_bytes",
     "legendFormat": "used",
     "refId": "A",
     "instant": false,
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "redis_memory_max_bytes",
     "legendFormat": "limit",
     "refId": "B",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 8,
      "lineWidth": 2,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 3,
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 7
   }
  },
  {
   "type": "table",
   "title": "Dashboard refresh runs (Airflow)",
   "description": "Each published run refreshes Superset (task refresh_dashboards).",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "warehouse"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "warehouse"
     },
     "rawSql": "SELECT run_id, status, published, started_at, finished_at, message\n        FROM ops.pipeline_runs ORDER BY started_at DESC LIMIT 10",
     "format": "table",
     "refId": "A",
     "editorMode": "code",
     "rawQuery": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "id": 4,
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 7
   }
  },
  {
   "type": "logs",
   "title": "Superset errors",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{service=\"superset\"} |~ \"(?i)error|timeout|exception\"",
     "refId": "A"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   },
   "id": 5,
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 24,
    "h": 7
   }
  }
 ],
 "templating": {
  "list": []
 }
}
